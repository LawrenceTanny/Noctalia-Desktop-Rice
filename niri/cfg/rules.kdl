// 1. Global Window Rules (Applies to everything)
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

// 2. Steam Notifications (Make them float)
window-rule {
    match app-id="^steam$" title="^Notification$"
    open-floating true
}

// 3. Noctalia Wallpaper Layer
layer-rule {
    match namespace="^noctalia-wallpaper*"
    place-within-backdrop true
}

// 4. File Pickers and Dialogs (Float in center)
window-rule {
    match app-id=r#"^xdg-desktop-portal-.*"#
    open-floating true
}

