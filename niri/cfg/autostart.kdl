// ────────────── Startup Applications ──────────────
    spawn-at-startup "dolphin" "--daemon"
    spawn-at-startup "/usr/lib/polkit-kde-authentication-agent-1"
    spawn-at-startup "kanshi"
    spawn-at-startup "wl-paste" "--watch" "cliphist" "store"
    //spawn-at-startup "waybar"


    // Parallax spatial wallpaper daemon
    spawn-at-startup "shiftpaperd"

    // Delay Noctalia slightly and retry if it crashes during boot
    spawn-sh-at-startup "sleep 0.5; noctalia || { sleep 1; noctalia; }"
